<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="l_open_track_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
    <render_engine>ogre</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Podeaua alba -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================= LINIE NEAGRA pe podea (traseul de urmat) ======================= -->
    <!-- Traseu marit fata de versiunea initiala, ca robotul sa aiba loc sa
         demonstreze diferenta de comportament intre viteza mica si mare -->

    <model name="line_vertical">
      <static>true</static>
      <pose>0 1.5 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.08 3.0 0.002</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="line_horizontal">
      <static>true</static>
      <pose>1.5 3.0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>3.0 0.08 0.002</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="line_corner">
      <static>true</static>
      <pose>0 3.0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ======================= PERETI - doar pe O SINGURA parte, mai departati =======================
         Nu mai e coridor inchis pe ambele laturi (asta ascundea diferenta de
         viteza si nu lasa loc de eroare). Acum e doar un perete "ghid" pe
         partea exterioara a traseului, la ~40cm distanta de linie, ca robotul
         sa aiba spatiu sa devieze si sa se vada clar corectiile de traiectorie
         la viteza mica vs mare. -->

    <model name="wall_outer_vertical">
      <static>true</static>
      <pose>-0.7 1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.05 3.0 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 3.0 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_outer_horizontal">
      <static>true</static>
      <pose>1.5 3.7 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.8 0.05 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.8 0.05 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ======================= OBSTACOLE RANDOM langa curba =======================
         Cateva cutii izolate (nu perete continuu), plasate random in jurul
         zonei de curba, pentru testarea senzorului de proximitate - exact
         cum a cerut Claudiu. Ajusteaza pozitiile/dimensiunile cum vreti. -->

    <!-- ======================= OBSTACOLE MODIFICATE ======================= -->
    
    <!-- Obstacol 1 mutat mai la dreapta (pe X) si mai in sus (pe Y) -->
    <model name="obstacle_1">
      <static>true</static>
      <pose>1.2 2.6 0.15 0 0 0</pose> 
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 0.15 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 0.15 0.3</size></box></geometry>
          <material><ambient>0.6 0.2 0.2 1</ambient><diffuse>0.6 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

   

    <!-- Obstacol 3 mutat mai sus pe Y pentru a nu bloca drumul -->
    <model name="obstacle_3">
      <static>true</static>
      <pose>2.5 3.3 0.1 0 0 0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 0.1 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 0.1 0.2</size></box></geometry>
          <material><ambient>0.5 0.5 0.2 1</ambient><diffuse>0.5 0.5 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
