<!-- 1. Senzor de proximitate central sus -->
<link name="sensor_prox_high_center_link">
  <visual>
    <geometry><box size="0.02 0.02 0.01"/></geometry>
    <material name="green"><color rgba="0.0 1.0 0.0 1.0"/></material>
  </visual>
  <sensor name="sensor_prox_high_center" type="gpu_ray">
    <pose>0 0 0 0 0 0</pose>
    <update_rate>20</update_rate>
    <ray>
      <scan>
        <horizontal>
          <samples>1</samples>
          <resolution>1</resolution>
          <min_angle>0</min_angle>
          <max_angle>0</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.02</min>
        <max>2.0</max>
      </range>
    </ray>
    <plugin filename="libgz-sim-sensors-system.so" name="gz::sim::systems::Sensors">
      <ros_topic>/obstacle/high_center</ros_topic>
    </plugin>
  </sensor>
</link>

<joint name="sensor_prox_high_center_joint" type="fixed">
  <origin xyz="0 0.5 0.07" rpy="0 0 0"/>
  <parent link="part_1"/>
  <child link="sensor_prox_high_center_link"/>
</joint>


