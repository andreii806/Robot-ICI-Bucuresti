<!-- Link-ul senzorului de linie -->
<link name="line_sensor_front_center_link">
  <visual>
    <geometry><box size="0.02 0.02 0.01"/></geometry>
    <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  </visual>
  <sensor name="line_sensor_front_center" type="gpu_ray">
    <!-- Pitch 1.5708 rad = 90 grade in jos -->
    <pose>0 0 0 0 1.5708 0</pose>
    <update_rate>20</update_rate>
    <ray>
      <scan>
        <horizontal>
          <samples>1</samples>
          <resolution>1</resolution>
          <min_angle>0</min_angle>
          <max_angle>0</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.005</min>
        <max>0.2</max>
      </range>
    </ray>
    <plugin filename="libgz-sim-sensors-system.so" name="gz::sim::systems::Sensors">
      <ros_topic>/line_sensor/front_center/scan</ros_topic>
    </plugin>
  </sensor>
</link>

