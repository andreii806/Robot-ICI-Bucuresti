<gazebo>
  <plugin filename="libgz-sim-diff-drive-system.so" name="gz::sim::systems::DiffDrive">
    <!-- Numele joint-urilor tale reale -->
    <left_joint>roata_s</left_joint>
    <right_joint>roata_d</right_joint>

    <!-- Dimensiuni (asigură-te că sunt egale cu cele reale din CAD) -->
    <wheel_separation>0.4</wheel_separation>
    <wheel_radius>0.075</wheel_radius>

    <!-- Comportament dinamic (Acestea lipsesc din codul tău) -->
    <odom_topic>odom</odom_topic>
    <frame_id>odom</frame_id>
    <child_frame_id>root</child_frame_id>
    
    <!-- Forța motorului (Să poată urni cele 20kg) -->
    <max_linear_acceleration>1.0</max_linear_acceleration>
    <max_angular_acceleration>2.0</max_angular_acceleration>
    
    <!-- Topic-ul pentru comenzi -->
    <topic>cmd_vel</topic>
  </plugin>
</gazebo>
<gazebo reference="car1">
    <!-- Coeficientul de frecare la alunecare (pune-l aproape de 0 pentru alunecare lină) -->
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    
    <!-- Parametri de contact pentru a preveni salturile sau blocurile fizice -->
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    
   
</gazebo>
